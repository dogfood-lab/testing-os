{
  "name": "@dogfood-lab/atlas",
  "version": "1.12.0",
  "type": "module",
  "description": "Read-only map of a git working tree onto named boundaries, with per-file import specifiers.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.js"
  },
  "files": [
    "index.js",
    "core/index.js",
    "core/resolve.js",
    "grammars/manifest.json",
    "grammars/tree-sitter-javascript.wasm",
    "grammars/tree-sitter-typescript.wasm",
    "grammars/tree-sitter-tsx.wasm",
    "grammars/tree-sitter-python.wasm",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 \"*.test.js\" \"core/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "enhanced-resolve": "5.25.1",
    "picomatch": "4.0.7",
    "web-tree-sitter": "0.27.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogfood-lab/testing-os.git",
    "directory": "packages/atlas"
  },
  "homepage": "https://github.com/dogfood-lab/testing-os",
  "bugs": {
    "url": "https://github.com/dogfood-lab/testing-os/issues"
  },
  "keywords": [
    "testing-os",
    "dogfood-lab",
    "atlas"
  ]
}
