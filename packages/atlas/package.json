{
  "name": "@dogfood-lab/atlas",
  "version": "1.13.0",
  "type": "module",
  "description": "Map a git working tree onto named boundaries, and check that map in the host test job.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.js"
  },
  "files": [
    "index.js",
    "core/index.js",
    "core/resolve.js",
    "core/entry-points.js",
    "core/history.js",
    "core/divergence.js",
    "core/doors.js",
    "core/reach.js",
    "core/landings.js",
    "core/sequence.js",
    "cli.js",
    "adapter/errors.js",
    "adapter/boundary-file.js",
    "adapter/artifact.js",
    "adapter/check.js",
    "adapter/commands.js",
    "adapter/write.js",
    "adapter/init.js",
    "adapter/propose.js",
    "adapter/templates.js",
    "adapter/statistics.js",
    "adapter/page.js",
    "adapter/changes.js",
    "adapter/divergence.js",
    "templates/atlas-refresh.yml",
    "grammars/manifest.json",
    "grammars/tree-sitter-javascript.wasm",
    "grammars/tree-sitter-typescript.wasm",
    "grammars/tree-sitter-tsx.wasm",
    "grammars/tree-sitter-python.wasm",
    "LICENSE"
  ],
  "bin": {
    "atlas": "./cli.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"*.test.js\" \"core/*.test.js\" \"adapter/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "enhanced-resolve": "5.25.1",
    "picomatch": "4.0.7",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogfood-lab/testing-os.git",
    "directory": "packages/atlas"
  },
  "homepage": "https://github.com/dogfood-lab/testing-os",
  "bugs": {
    "url": "https://github.com/dogfood-lab/testing-os/issues"
  },
  "keywords": [
    "testing-os",
    "dogfood-lab",
    "atlas"
  ]
}
