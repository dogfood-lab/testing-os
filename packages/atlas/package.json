{
  "name": "@dogfood-lab/atlas",
  "version": "1.22.0",
  "type": "module",
  "description": "Map a git working tree onto named boundaries, and check that map in the host test job.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./core": "./core/index.js",
    "./fleet": "./adapter/fleet.js"
  },
  "files": [
    "index.js",
    "core/index.js",
    "core/resolve.js",
    "core/python-manifest.js",
    "core/toml.js",
    "core/cargo.js",
    "core/rust.js",
    "core/rust-modules.js",
    "core/godot.js",
    "core/gdscript.js",
    "core/entry-points.js",
    "core/history.js",
    "core/divergence.js",
    "core/doors.js",
    "core/commands.js",
    "core/tool-configs.js",
    "core/spawned.js",
    "core/languages.js",
    "core/reach.js",
    "core/landings.js",
    "core/guards.js",
    "core/text.js",
    "core/bundles.js",
    "core/sequence.js",
    "core/http.js",
    "core/unseen.js",
    "cli.js",
    "adapter/errors.js",
    "adapter/engine.js",
    "adapter/boundary-file.js",
    "adapter/artifact.js",
    "adapter/check.js",
    "adapter/commands.js",
    "adapter/write.js",
    "adapter/init.js",
    "adapter/propose.js",
    "adapter/templates.js",
    "adapter/statistics.js",
    "adapter/page.js",
    "adapter/changes.js",
    "adapter/explain.js",
    "adapter/diff.js",
    "adapter/divergence.js",
    "adapter/fleet.js",
    "sidecar/git.js",
    "sidecar/protocol.js",
    "sidecar/schema.js",
    "sidecar/server.js",
    "sidecar/tools.js",
    "bin/atlas-fleet.js",
    "templates/atlas-refresh.yml",
    "grammars/manifest.json",
    "grammars/tree-sitter-javascript.wasm",
    "grammars/tree-sitter-typescript.wasm",
    "grammars/tree-sitter-tsx.wasm",
    "grammars/tree-sitter-python.wasm",
    "grammars/tree-sitter-rust.wasm",
    "grammars/tree-sitter-gdscript.wasm",
    "LICENSE"
  ],
  "bin": {
    "atlas": "./cli.js",
    "atlas-fleet": "./bin/atlas-fleet.js"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 \"*.test.js\" \"core/*.test.js\" \"adapter/*.test.js\" \"sidecar/*.test.js\"",
    "test:parallel": "node --test --test-concurrency=8 \"*.test.js\" \"core/*.test.js\" \"adapter/*.test.js\" \"sidecar/*.test.js\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "enhanced-resolve": "5.25.1",
    "picomatch": "4.0.7",
    "web-tree-sitter": "0.27.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "mcp-tool-shop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dogfood-lab/testing-os.git",
    "directory": "packages/atlas"
  },
  "homepage": "https://github.com/dogfood-lab/testing-os",
