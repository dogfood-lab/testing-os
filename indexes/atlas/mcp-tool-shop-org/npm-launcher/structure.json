          "step": "Extract CHANGELOG section for the release notes",
          "text": "# This CHANGELOG uses Keep-a-Changelog bracketed headings\n# (\"## [1.2.1] - 2026-03-25\"); the optional brackets keep this working\n# if the style is ever unbracketed.\nVERSION=\"${{ steps.tag.outputs.version }}\"\nawk -v ver=\"$VERSION\" '\n  /^## / {\n    if (inSection) exit\n    h = $0\n    gsub(/[][]/, \"\", h)          # tolerate both \"## 1.1.1\" and \"## [1.1.1]\"\n    if (h ~ (\"^## \" ver \"( |$)\")) inSection = 1\n    next\n  }\n  inSection { print }\n' CHANGELOG.md > release-notes.md\nif [ -s release-notes.md ]; then\n  echo \"have_notes=true\" >> \"$GITHUB_OUTPUT\"\nelse\n  echo \"have_notes=false\" >> \"$GITHUB_OUTPUT\"\nfi\n"
