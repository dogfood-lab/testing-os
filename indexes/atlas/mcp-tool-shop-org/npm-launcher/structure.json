          "step": "Verify wrapper exists + version matches",
          "text": "test -f package.json || { echo \"::error::examples/${{ inputs.tool }}/package.json missing\"; exit 1; }\ntest -f \"bin/${{ inputs.tool }}.js\" || { echo \"::error::examples/${{ inputs.tool }}/bin/${{ inputs.tool }}.js missing\"; exit 1; }\n# README + LICENSE are listed in package.json `files` but npm publish\n# silently skips missing entries — leaving the npmjs.com page blank.\n# Sovereignty 2.0.2 + 2.1.0 shipped blank because of this; refuse\n# to publish here so the gap can't recur.\ntest -f README.md || { echo \"::error::examples/${{ inputs.tool }}/README.md missing — copy from the tool repo before publishing (see memory/npm-launcher.md Step 0). npm publish would silently ship a blank package page.\"; exit 1; }\ntest -f LICENSE || { echo \"::error::examples/${{ inputs.tool }}/LICENSE missing — copy from the tool repo before publishing.\"; exit 1; }\n# README must not be the trivial 1-line stub — guard against the\n# \"I created the file but didn't copy real content\" failure mode.\nREADME_BYTES=$(wc -c < README.md)\nif [ \"$README_BYTES\" -lt 200 ]; then\n  echo \"::error::examples/${{ inputs.tool }}/README.md is only ${README_BYTES} bytes — looks like a stub. Copy the real README from the tool repo.\"\n  exit 1\nfi\nACTUAL=$(node -p \"require('./package.json').version\")\nEXPECTED=\"${{ inputs.version }}\"\nif [ \"$ACTUAL\" != \"$EXPECTED\" ]; then\n  echo \"::error::package.json version is '$ACTUAL', expected '$EXPECTED'. Bump the wrapper files + commit to main before dispatching this workflow.\"\n  exit 1\nfi\necho \"Wrapper verified at $EXPECTED (README ${README_BYTES} bytes, LICENSE present)\"\n"
