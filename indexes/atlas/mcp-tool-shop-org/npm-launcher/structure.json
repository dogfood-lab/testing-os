          "step": "Install npm >=11.5 in a sandbox for OIDC trusted-publishing auth",
          "text": "# Node 22 ships npm 10.9, which signs provenance but cannot negotiate\n# the OIDC auth path (PUT returns a misleading 404). An in-place\n# `npm i -g npm@latest` races the bundled arborist and breaks — install\n# npm@latest into a sandbox dir and shadow the system npm via PATH.\nSANDBOX=\"$HOME/.npm-cli-sandbox\"\nmkdir -p \"$SANDBOX\"\npushd \"$SANDBOX\" >/dev/null\necho '{\"name\":\"npm-cli-sandbox\",\"version\":\"0.0.0\",\"private\":true}' > package.json\nnpm install --no-save --no-audit --no-fund --silent npm@latest\npopd >/dev/null\necho \"$SANDBOX/node_modules/.bin\" >> \"$GITHUB_PATH\"\n\"$SANDBOX/node_modules/.bin/npm\" --version\n"
        },
        {
          "job": "release",
          "step": "Resolve tag",
          "text": "TAG=\"${{ github.event.inputs.tag || github.ref_name }}\"\necho \"tag=${TAG}\" >> \"$GITHUB_OUTPUT\"\necho \"version=${TAG#v}\" >> \"$GITHUB_OUTPUT\"\n"
        },
        {
          "job": "release",
          "step": "Verify tag matches package.json version",
          "text": "PKG_VERSION=$(node -p \"require('./package.json').version\")\nTAG_VERSION=\"${{ steps.tag.outputs.version }}\"\necho \"Tag: ${{ steps.tag.outputs.tag }} -> ${TAG_VERSION} | package.json: ${PKG_VERSION}\"\nif [ \"${PKG_VERSION}\" != \"${TAG_VERSION}\" ]; then\n  echo \"::error::Tag ${TAG_VERSION} does not match package.json version ${PKG_VERSION}\"\n  exit 1\nfi\n"
        },
        {
          "job": "release",
          "step": "Install dependencies (lockfile-aware)",
          "text": "# This package ships zero dependencies and therefore has no\n# package-lock.json; `npm ci` hard-fails with EUSAGE when one is\n# absent. Install only when there is something to install rather than\n# committing an empty lockfile to satisfy the command.\nif [ -f package-lock.json ]; then\n  npm ci\nelse\n  echo \"no package-lock.json (zero-dependency package) - using npm install\"\n  npm install --no-audit --no-fund\nfi\n"
