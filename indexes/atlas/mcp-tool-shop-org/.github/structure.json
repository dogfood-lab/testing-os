        {
          "job": "check-org-repos",
          "step": "Scan all org repos for regressions",
          "text": "set -uo pipefail\n\nORG=\"mcp-tool-shop-org\"\nfail=0\nfindings=\"$RUNNER_TEMP/org_guard_findings.md\"\necho \"# Org Guard Findings\" > \"$findings\"\necho \"\" >> \"$findings\"\n\n# Fetch all non-archived repos (single paginated call, reuse JSON)\nrepos_json=\"$(gh api -H \"Accept: application/vnd.github+json\" \\\n  \"/orgs/${ORG}/repos?per_page=100&type=all\" --paginate)\"\nrepos=\"$(echo \"$repos_json\" | jq -r '.[] | select(.archived == false) | .name' | sort)\"\n\nrepo_count=$(echo \"$repos\" | wc -l)\necho \"Scanning $repo_count non-archived repos...\"\n\nfor repo in $repos; do\n  echo \"\"\n  echo \"==> $repo\"\n\n  # --- 1. Default branch must be main ---\n  default_branch=\"$(echo \"$repos_json\" | jq -r --arg r \"$repo\" \\\n    '.[] | select(.name==$r) | .default_branch')\"\n  if [[ \"$default_branch\" != \"main\" ]]; then\n    echo \"::error::$repo — default branch is '$default_branch' (expected 'main')\"\n    echo \"- :x: **$repo** default branch is \\`$default_branch\\` (expected \\`main\\`).\" >> \"$findings\"\n    fail=1\n  fi\n\n  # --- 2. Stale master branch ---\n  if gh api \"repos/${ORG}/${repo}/branches/master\" --jq '.name' 2>/dev/null | grep -q master; then\n    echo \"::warning::$repo — stale 'master' branch exists alongside '$default_branch'\"\n    echo \"- :warning: **$repo** stale \\`master\\` branch exists alongside \\`$default_branch\\`.\" >> \"$findings\"\n    fail=1\n  fi\n\n  # --- 3. README: branch=master or /master/ in URLs ---\n  # Use /readme endpoint (handles README.rst, README.adoc, etc.)\n  readme_b64=\"$(gh api \"repos/${ORG}/${repo}/readme\" --jq '.content' 2>/dev/null | tr -d '\\n')\" || true\n  if [[ -n \"$readme_b64\" ]]; then\n    readme=\"$(printf \"%s\" \"$readme_b64\" | base64 -d 2>/dev/null || true)\"\n    if echo \"$readme\" | grep -qE 'branch=master|/actions/workflows/[^)]*\\?branch=master'; then\n      echo \"::warning::$repo — README contains branch=master in badge URL\"\n      echo \"- :warning: **$repo** README contains \\`branch=master\\` in badge URL.\" >> \"$findings\"\n      fail=1\n    fi\n  fi\n\n  # --- 4. Workflow files: master triggers + action floors ---\n  wf_list=\"$(gh api \"repos/${ORG}/${repo}/contents/.github/workflows\" \\\n    --jq '.[] | select(.type==\"file\") | select(.name | test(\"\\\\.ya?ml$\")) | .path' 2>/dev/null)\" || true\n  [[ -z \"$wf_list\" ]] && continue\n\n  while IFS= read -r path; do\n    [[ -z \"$path\" ]] && continue\n    f=\"$(basename \"$path\")\"\n\n    wf_b64=\"$(gh api \"repos/${ORG}/${repo}/contents/${path}\" --jq '.content' 2>/dev/null | tr -d '\\n')\" || true\n    [[ -z \"$wf_b64\" ]] && continue\n    wf=\"$(printf \"%s\" \"$wf_b64\" | base64 -d 2>/dev/null || true)\"\n    [[ -z \"$wf\" ]] && continue\n\n    # This guard's own file carries the detection patterns below as\n    # literals. Scanning it matches the rule it implements, which made\n    # the guard report a permanent finding against itself.\n    if [[ \"$repo\" == \".github\" && \"$f\" == \"org-guard.yml\" ]]; then\n      continue\n    fi\n\n    # Master branch triggers\n    if echo \"$wf\" | grep -qE 'branches:\\s*\\[.*master'; then\n      echo \"::warning::$repo/$f — workflow triggers on 'master'\"\n      echo \"- :warning: **$repo** \\`$f\\` triggers on \\`master\\`.\" >> \"$findings\"\n      fail=1\n    fi\n\n    # Action pinned to @master (supply chain risk)\n    # Match @master at end of line or followed by quote/whitespace\n    if echo \"$wf\" | grep -qE '@master[\"[:space:]]|@master$'; then\n      echo \"::warning::$repo/$f — action pinned to @master (supply chain risk)\"\n      echo \"- :warning: **$repo** \\`$f\\` uses an action pinned to \\`@master\\`.\" >> \"$findings\"\n      fail=1\n    fi\n\n    # Version floors (match @vN but not @vNN, e.g. @v5 but not @v50)\n    if echo \"$wf\" | grep -qE 'actions/setup-python@v[1-5][^0-9]'; then\n      echo \"::warning::$repo/$f — setup-python below v6\"\n      echo \"- :warning: **$repo** \\`$f\\` uses \\`setup-python\\` below v6.\" >> \"$findings\"\n      fail=1\n    fi\n\n    if echo \"$wf\" | grep -qE 'codecov/codecov-action@v[1-4][^0-9]'; then\n      echo \"::warning::$repo/$f — codecov-action below v5\"\n      echo \"- :warning: **$repo** \\`$f\\` uses \\`codecov-action\\` below v5.\" >> \"$findings\"\n      fail=1\n    fi\n  done <<< \"$wf_list\"\ndone\n\n# --- Summary ---\necho \"\" >> \"$findings\"\nif [[ \"$fail\" -eq 1 ]]; then\n  echo \"## Status: FAIL\" >> \"$findings\"\n  echo \"Found regressions. Fix and re-run org-guard.\" >> \"$findings\"\nelse\n  echo \"## Status: PASS\" >> \"$findings\"\n  echo \"No regressions detected across $repo_count repos.\" >> \"$findings\"\nfi\n\necho \"----\"\ncat \"$findings\"\necho \"----\"\n\nexit \"$fail\"\n"
