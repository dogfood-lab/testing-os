        },
        {
          "job": "check-org-standards",
          "step": "Check for forbidden 'master' branch references in workflows",
          "text": "echo \"=== Checking for 'master' branch references in .github repo workflows ===\"\nviolations=0\n\nfor f in .github/workflows/*.yml; do\n  # Skip this workflow itself\n  [ \"$(basename \"$f\")\" = \"org-guard.yml\" ] && continue\n\n  if grep -n 'branches:.*master' \"$f\" 2>/dev/null; then\n    echo \"::warning file=$f::Found 'master' branch reference — use 'main' instead\"\n    violations=$((violations + 1))\n  fi\ndone\n\nif [ \"$violations\" -gt 0 ]; then\n  echo \"::warning::Found $violations workflow(s) referencing 'master' branch\"\nelse\n  echo \"All workflows use 'main' branch references\"\nfi\n"
        },
        {
          "job": "check-org-standards",
          "step": "Check action version floors",
          "text": "echo \"=== Checking action version floors ===\"\nwarnings=0\n\nfor f in .github/workflows/*.yml; do\n  # setup-python must be v6+\n  if grep -qE 'actions/setup-python@v[1-5]' \"$f\" 2>/dev/null; then\n    echo \"::warning file=$f::setup-python below v6 — update to actions/setup-python@v6\"\n    warnings=$((warnings + 1))\n  fi\n\n  # codecov-action must be v5+\n  if grep -qE 'codecov/codecov-action@v[1-4]' \"$f\" 2>/dev/null; then\n    echo \"::warning file=$f::codecov-action below v5 — update to codecov/codecov-action@v5\"\n    warnings=$((warnings + 1))\n  fi\n\n  # checkout should be v6+\n  if grep -qE 'actions/checkout@v[1-5]' \"$f\" 2>/dev/null; then\n    echo \"::warning file=$f::checkout below v6 — update to actions/checkout@v6\"\n    warnings=$((warnings + 1))\n  fi\n\n  # setup-dotnet should be v4+\n  if grep -qE 'actions/setup-dotnet@v[1-3]' \"$f\" 2>/dev/null; then\n    echo \"::warning file=$f::setup-dotnet below v4 — update to actions/setup-dotnet@v4\"\n    warnings=$((warnings + 1))\n  fi\n\n  # setup-node should be v4+\n  if grep -qE 'actions/setup-node@v[1-3]' \"$f\" 2>/dev/null; then\n    echo \"::warning file=$f::setup-node below v4 — update to actions/setup-node@v4\"\n    warnings=$((warnings + 1))\n  fi\ndone\n\nif [ \"$warnings\" -gt 0 ]; then\n  echo \"::warning::Found $warnings action(s) below version floor\"\nelse\n  echo \"All actions meet version floors\"\nfi\n"
