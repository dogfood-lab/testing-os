          "text": "echo \"=== Checking required org docs ===\"\nerrors=0\n\nfor doc in SUPPORT.md SECURITY.md CODE_OF_CONDUCT.md CONTRIBUTING.md LICENSE; do\n  if [ ! -f \"$doc\" ]; then\n    echo \"::error::Missing required org doc: $doc\"\n    errors=$((errors + 1))\n  else\n    echo \"OK: $doc exists\"\n  fi\ndone\n\n# Check SUPPORT.md has Discussions links\nif [ -f \"SUPPORT.md\" ]; then\n  if ! grep -q '/discussions' SUPPORT.md; then\n    echo \"::warning file=SUPPORT.md::No Discussions links found — add repo discussion URLs\"\n  else\n    count=$(grep -c '/discussions' SUPPORT.md)\n    echo \"OK: SUPPORT.md contains $count Discussions links\"\n  fi\nfi\n\n# Check brand kit exists\nfor doc in brand/README.md brand/palette.md brand/og/manifest.json; do\n  if [ ! -f \"$doc\" ]; then\n    echo \"::warning::Missing brand asset: $doc\"\n    errors=$((errors + 1))\n  else\n    echo \"OK: $doc exists\"\n  fi\ndone\n\nif [ \"$errors\" -gt 0 ]; then\n  echo \"::error::Found $errors missing doc(s)\"\n  exit 1\nfi\n"
