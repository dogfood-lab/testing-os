{
  "name": "lock-root",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "lock-root",
      "workspaces": [
        "site"
      ]
    },
    "node_modules/@esbuild/win32-x64": {
      "version": "0.25.10",
      "cpu": [
        "x64"
      ],
      "optional": true,
      "os": [
        "win32"
      ]
    },
    "node_modules/astro": {
      "version": "7.3.3",
      "bin": {
        "astro": "astro.js"
      },
      "engines": {
        "node": ">=22.12.0",
        "npm": ">=9.6.5"
      }
    },
    "node_modules/esbuild": {
      "version": "0.25.10",
      "bin": {
        "esbuild": "bin/esbuild"
      },
      "optionalDependencies": {
        "@esbuild/darwin-arm64": "0.25.10",
        "@esbuild/linux-x64": "0.25.10",
        "@esbuild/win32-x64": "0.25.10"
      }
    },
    "node_modules/older-bundler": {
      "version": "1.0.0",
      "dependencies": {
        "esbuild": "0.18.20"
      }
    },
    "node_modules/older-bundler/node_modules/@esbuild/linux-x64": {
      "version": "0.18.20",
      "cpu": [
        "x64"
      ],
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "node_modules/older-bundler/node_modules/esbuild": {
      "version": "0.18.20",
      "bin": "bin/esbuild",
      "optionalDependencies": {
        "@esbuild/linux-x64": "0.18.20",
        "@esbuild/win32-x64": "0.18.20"
      }
    },
    "node_modules/site-docs": {
      "resolved": "site",
      "link": true
    },
    "site": {
      "name": "site-docs"
    },
    "site/node_modules/vite": {
      "version": "7.1.0",
      "bin": {
        "vite": "bin/vite.js"
      },
      "engines": {
        "node": "^20.19.0 || >=22.12.0"
      }
    }
  }
